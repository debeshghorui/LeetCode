{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./src/*"],
            "@/assets/*": ["./assets/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "env.ts",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ]
}
