{
    "cli": {
        "version": ">= 22.2.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "APP_VARIANT": "development"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "APP_VARIANT": "preview"
            }
        },
        "production": {
            "autoIncrement": true,
            "env": {
                "APP_VARIANT": "production"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
