{
    "cli": {
        "version": ">= 22.2.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "environment": "development",
            "channel": "development"
        },
        "preview": {
            "distribution": "internal",
            "environment": "preview",
            "android": {
                "buildType": "apk"
            },
            "channel": "preview"
        },
        "production": {
            "autoIncrement": true,
            "environment": "production",
            "channel": "production",
            "android": {
                "buildType": "app-bundle"
            }
        }
    },
    "submit": {
        "production": {
            "android": {
                "track": "internal",
                "releaseStatus": "completed"
            }
        }
    }
}
